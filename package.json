    "walkthroughs": [
      {
        "id": "sshManager.gettingStarted",
        "title": "Get Started with SSH Config Manager",
        "description": "Organize your SSH hosts in folders, tidy the Remote-SSH list, and keep the config backed up and in sync.",
        "steps": [
          {
            "id": "wizard",
            "title": "Take the one-minute setup",
            "description": "The setup wizard walks through everything below, one screen at a time. You can run it again whenever you like.\n[Open the Setup Wizard](command:sshManager.wizard)",
            "media": {
              "image": "media/art/welcome.jpg",
              "altText": "A terminal window connected to a stack of servers"
            },
            "completionEvents": [
              "onCommand:sshManager.wizard"
            ]
          },
          {
            "id": "folders",
            "title": "Organize hosts in folders",
            "description": "Make a folder for each project or customer, with subfolders inside for things like Production and Staging. Drag hosts between them.\n[New Folder](command:sshManager.addGroup)",
            "media": {
              "image": "media/art/folders.jpg",
              "altText": "A folder holding two subfolders of servers"
            },
            "completionEvents": [
              "onCommand:sshManager.addGroup"
            ]
          },
          {
            "id": "picker",
            "title": "Tidy the Remote-SSH list",
            "description": "VS Code’s own “Connect to Host” list can show the same folders, with headings and a gap between them.\n[Format the Remote-SSH List](command:sshManager.remoteSpacing)",
            "media": {
              "image": "media/art/picker.jpg",
              "altText": "A list of hosts arranged in groups"
            },
            "completionEvents": [
              "onCommand:sshManager.remoteSpacing"
            ]
          },
          {
            "id": "backup",
            "title": "Backups you can restore",
            "description": "A copy of the config is saved in a folder next to it before every change.\n[Back Up Now](command:sshManager.backupNow)\n[Restore from a Backup](command:sshManager.restoreBackup)",
            "media": {
              "image": "media/art/backup.jpg",
