{
  "name": "ssh-config-manager",
  "displayName": "SSH Config Manager",
  "description": "SSH manager for VS Code: organize your ssh_config in a side bar with groups, icons, colors, tags, notes and favorites, stored as comments inside the config file itself. Connect in a terminal or via Remote-SSH.",
  "version": "0.5.2",
  "publisher": "vrxt",
  "author": {
    "name": "Mushari Alshqar"
  },
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0b3d91",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/VRXT/ssh-config-manager.git"
  },
  "bugs": {
    "url": "https://github.com/VRXT/ssh-config-manager/issues"
  },
  "homepage": "https://github.com/VRXT/ssh-config-manager#readme",
  "keywords": [
    "ssh",
    "ssh manager",
    "ssh config",
    "ssh config manager",
    "ssh_config",
    "ssh hosts",
    "ssh client",
    "ssh connection",
    "connection manager",
    "host manager",
    "server manager",
    "remote-ssh",
    "remote",
    "terminal",
    "servers",
    "hosts",
    "devops",
    "sysadmin",
    "homelab"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sshManager",
          "title": "SSH Config Manager",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "sshManager": [
        {
          "type": "webview",
          "id": "sshManager.search",
          "name": "Search",
          "initialSize": 2
        },
        {
          "id": "sshManager.hosts",
          "name": "Hosts",
          "initialSize": 5
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "sshManager.hosts",
        "contents": "No hosts found in your SSH config.\n[Add Host](command:sshManager.addHost)\n[Open Config File](command:sshManager.openConfig)"
      }
    ],
    "configuration": {
      "title": "SSH Config Manager",
      "properties": {
        "sshManager.configFile": {
          "type": "string",
          "default": "~/.ssh/config",
          "scope": "machine",
          "description": "Path of the SSH config file to manage. Every other setting lives inside that file as a '#@ssh-manager' comment."
        },
        "sshManager.backup.keep": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 500,
          "markdownDescription": "How many backups to keep. A backup is saved in the `ssh-config-backups` folder next to the config file before every change."
        },
        "sshManager.sync.mode": {
          "type": "string",
          "enum": [
            "off",
            "copy",
            "link",
            "include"
          ],
          "default": "off",
          "scope": "machine",
          "enumDescriptions": [
            "Not syncing.",
            "Copy both ways between the config and the shared file.",
            "The config is a link to the shared file.",
            "~/.ssh/config includes the shared file."
          ],
          "markdownDescription": "How this computer shares its SSH config with your other computers. Set it up with **SSH Manager: Set Up Sync Between Computers…** rather than by hand."
        },
        "sshManager.sync.file": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "The shared config file in a synced folder (Dropbox, iCloud Drive, OneDrive, …). SSH keys are never synced."
        }
      }
    },
    "keybindings": [
      {
        "command": "sshManager.quickConnect",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s"
      },
      {
        "command": "sshManager.connect",
        "key": "enter",
        "mac": "enter",
        "when": "focusedView == sshManager.hosts && sshManager.selection == host"
      },
      {
        "command": "sshManager.connectNewWindow",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "focusedView == sshManager.hosts && sshManager.selection == host"
      },
      {
        "command": "sshManager.connectTerminal",
        "key": "alt+enter",
        "mac": "alt+enter",
        "when": "focusedView == sshManager.hosts && sshManager.selection == host"
      },
      {
        "command": "sshManager.copySsh",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "focusedView == sshManager.hosts && sshManager.selection == host"
      },
      {
        "command": "sshManager.addHost",
        "key": "ctrl+n",
        "mac": "cmd+n",
        "when": "focusedView == sshManager.hosts"
      },
      {
        "command": "sshManager.addGroup",
        "key": "ctrl+shift+n",
        "mac": "cmd+shift+n",
        "when": "focusedView == sshManager.hosts"
      },
      {
        "command": "sshManager.editHost",
        "key": "f2",
        "mac": "f2",
        "when": "focusedView == sshManager.hosts && sshManager.selection == host"
      },
      {
        "command": "sshManager.renameGroup",
        "key": "f2",
        "mac": "f2",
        "when": "focusedView == sshManager.hosts && sshManager.selection == folder"
      },
      {
        "command": "sshManager.duplicateHost",
        "key": "ctrl+shift+d",
        "mac": "cmd+shift+d",
        "when": "focusedView == sshManager.hosts && sshManager.selection == host"
      },
      {
        "command": "sshManager.toggleFavorite",
        "key": "ctrl+d",
        "mac": "cmd+d",
        "when": "focusedView == sshManager.hosts && sshManager.selection == host"
      },
      {
        "command": "sshManager.moveUp",
        "key": "alt+up",
        "mac": "alt+up",
        "when": "focusedView == sshManager.hosts"
      },
      {
        "command": "sshManager.moveDown",
        "key": "alt+down",
        "mac": "alt+down",
        "when": "focusedView == sshManager.hosts"
      },
      {
        "command": "sshManager.deleteHost",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "focusedView == sshManager.hosts && sshManager.selection == host"
      },
      {
        "command": "sshManager.deleteGroup",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "focusedView == sshManager.hosts && sshManager.selection == folder"
      },
      {
        "command": "sshManager.filter",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "focusedView == sshManager.hosts"
      },
      {
        "command": "sshManager.settingsPage",
        "key": "ctrl+,",
        "mac": "cmd+,",
        "when": "focusedView == sshManager.hosts"
      }
    ],
